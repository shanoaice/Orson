<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Pacpar.Alpm</PackageId>
    <Version>0.1.0</Version>
    <Authors>shanoaice</Authors>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Description>C# binding for libalpm, the library behind pacman.</Description>
    <PackageProjectUrl>https://codeberg.org/shanoaice/Pacpar/</PackageProjectUrl>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk"/>

  <ItemGroup>
    <!-- ADR 0006 keeps the binding layer internal to this assembly. In-repo tooling that has to
         reach the raw entry points (the test suite's binding-pairing audit, and the marshalling
         benchmarks that measure libalpm calls directly) is granted friend access explicitly; an
         external consumer is not. -->
    <InternalsVisibleTo Include="Pacpar.Alpm.Tests" />
    <InternalsVisibleTo Include="Pacpar.Benchmarks" />
    <InternalsVisibleTo Include="Pacpar.Alpm.FSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="**\*.Seams.cs" DependentUpon="$([System.IO.Path]::GetFileNameWithoutExtension('%(Filename)')).cs" />
  </ItemGroup>

  <PropertyGroup>
    <BuildDependsOn>
    GenerateBindings;$(BuildDependsOn)
    </BuildDependsOn>
  </PropertyGroup>

  <Target Name="GenerateBindings">
    <Exec Command="cargo build -p libalpm-sys-cs"/>
  </Target>

</Project>
