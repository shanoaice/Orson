{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Orson.Alpm/Orson.Alpm.csproj"
          ]
        }
      ],
      "dest": "obj/api",
      "categoryLayout": "nested"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      },
      {
        "src": "obj/api",
        "files": [
          "**/*.yml"
        ],
        "exclude": [
          "toc.yml"
        ],
        "dest": "api"
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Orson.Alpm",
      "_appTitle": "Orson.Alpm",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
